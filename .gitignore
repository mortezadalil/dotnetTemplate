## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio 2015/2017 cache/options directory
.vs/

# Visual Studio Code
.vscode/
*.code-workspace

# Rider
.idea/
*.sln.iml

# User-specific files
*.rsuser

# NuGet Packages
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/

# SQLite database files
*.db
*.db-shm
*.db-wal

# EF Core Migrations (keep the folder, ignore database files)
**/Migrations/*.db

# Rider
.idea/

# macOS
.DS_Store

# Windows
Thumbs.db

# Logs
logs/
*.log

# Environment variables
.env
.env.local
.env.*.local

# Seq
seq-data/
